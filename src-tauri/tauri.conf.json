{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Master",
  "version": "0.2.0",
  "identifier": "com.pdfmaster.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Master",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Annotate, measure, stamp and present PDF documents",
    "longDescription": "PDF Master is a precision glass studio for annotating PDF and paper documents: ink, shapes, text, formulas, calibrated measurements, stamps, snapshots, crop and presentation mode.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
